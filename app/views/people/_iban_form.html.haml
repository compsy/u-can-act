- if can? :update, Person, :iban
  %h5= t('pages.person.bank_details')
  %p{style: @person.iban.blank? ? 'color:red' : ''}
    = t('pages.person.iban_needed')
  %p
    = t('pages.person.iban_stored_separately')
  .input-field
    = f.text_field :iban, placeholder: 'NL12 RABO 0123 4123 41', autofocus: true, required: true, pattern: "^[a-zA-Z]{2}[0-9]{2}[ ]?[a-zA-Z0-9]{4}[ ]?[0-9 ]{7}([a-zA-Z0-9 ]?){0,16}$", title: t('pages.person.iban_title')
    = f.label :iban
  = render partial: 'name_fields', locals: {f: f} 
  .actions
    = render 'submit_button', f: f, text: t('questionnaires.save')
